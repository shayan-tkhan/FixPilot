# Node.js 24. Copy to .env.local. These values are disposable local-demo settings.
SESSION_SECRET=replace-with-a-random-string-of-at-least-32-characters
DEMO_PASSWORD=demo123
JIRA_MODE=local
# Local app only. Never use Vercel /tmp for incident persistence.
FIXPILOT_DB=.data/fixpilot.sqlite
# Vercel only: provision a managed Postgres database, then add its connection URL.
# DATABASE_URL=postgresql://...
# Optional externally hosted controlled lab. Default local app origin.
# LAB_BASE_URL=http://localhost:3000
# Explicit Jira sandbox configuration; keep secrets on the server.
# JIRA_MODE=sandbox
# JIRA_BASE_URL=https://your-sandbox.atlassian.net
# JIRA_EMAIL=dedicated-sandbox-account@example.com
# JIRA_API_TOKEN=
# JIRA_PROJECT_KEY=LAB
# JIRA_ALLOWED_KEYS=LAB-101,LAB-102,LAB-103,LAB-104,LAB-105,LAB-100
# JIRA_PARENT_KEY=LAB-100
# JIRA_TRANSITION_ID=31
# JIRA_TARGET_STATUS_ID=10001

# Protected Vercel production deployment origin; server-controlled lab destination.
# APP_ORIGIN=https://your-project.vercel.app
# VERCEL_AUTOMATION_BYPASS_SECRET is managed by Vercel. Never expose it to clients.

# Optional: isolated schema for a separate public demo backend. Default is public.
# APP_DB_SCHEMA=fixpilot_public_demo
# AI Gateway authenticates with VERCEL_OIDC_TOKEN on Vercel or AI_GATEWAY_API_KEY locally.
# Gateway account verification/credits must be active before real model calls work.
# AI_GATEWAY_API_KEY=
# AI_GATEWAY_MODEL=alibaba/qwen3.6-35b-a3b
# Browser Web Push (generate keys once; keep the private key server-side).
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
